# .env.example
# ─────────────
# Copy to .env and fill in your values. NEVER commit .env to version control.
#
# IMPORTANT: Vite bakes VITE_* variables into the client bundle at BUILD TIME.
# On Netlify/Vercel, set these in the dashboard build environment settings
# BEFORE triggering a build (not just in runtime env).

# ── Stripe (optional — only needed when payments.mode = "stripe") ─────────────
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here

# ── Resend (required for booking confirmation / reminder emails) ──────────────
# Get a key at resend.com after verifying a sending domain. The From address
# set in Admin > Emails must be on that verified domain.
# RESEND_API_KEY=re_your_key_here
